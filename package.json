{
  "name": "adm",
  "version": "0.2.0",
  "description": "ADM — Rust + Tauri 2 + SolidJS ile çok kanallı gelişmiş indirme yöneticisi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p src-extension/tsconfig.json --noEmit",
    "extension:build": "tsc -p src-extension/tsconfig.json",
    "extension:watch": "tsc -p src-extension/tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon app-icon.svg"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/chrome": "^0.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.12"
  }
}
