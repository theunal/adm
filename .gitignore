# Bağımlılıklar
node_modules/

# Derleme çıktıları
dist/
src-tauri/target/
src-tauri/gen/schemas/

# Tarayıcı eklentisinin derlenmiş çıktısı. Kaynak `src-extension/src/*.ts`
# altındadır; `npm run extension:build` üretir. Tauri paketi ve kurulum
# sihirbazı yalnızca bu klasörü kopyalar.
src-extension/build/

# Tarayıcı eklentisi dağıtım çıktıları.
# `npm run extension:dist` -> dist/, ardından crx/release ve Inno Setup çıktısı.
# Bunlar GitHub Actions'ta üretilir; depoda yalnızca kaynak tutulur.
src-extension/dist/
src-extension/release/
src-extension/installer-out/

# CRX imza anahtarı. Depoya girerse eklenti kimliği herkese açık olur ve
# kaybedilirse kimlik kalıcı olarak değişir. GitHub secret olarak saklanır.
keys/
*.pem

# Yerel dosyalar
*.log
.DS_Store
Thumbs.db

# Not: package-lock.json bilerek yok sayılmıyor — kurulumun tekrarlanabilir
# olması için kilit dosyası sürüm kontrolünde tutulur.

.refs
.kilo
.workbuddy-ai